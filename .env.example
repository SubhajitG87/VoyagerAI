# LLM backend. Defaults to local Ollama.
VOYAGER_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Alternative local/server backend for LM Studio, vLLM, llama.cpp server, etc.
# VOYAGER_LLM_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPATIBLE_API_KEY=

# Model presets: small, balanced, quality.
VOYAGER_MODEL_PRESET=balanced

# Optional per-agent overrides.
# VOYAGER_AGENT_MODEL_DISCOVERY=qwen3:14b
# VOYAGER_AGENT_MODEL_FLIGHT=mistral-small3.1:24b
# VOYAGER_AGENT_MODEL_VISA=mistral-small3.1:24b
# VOYAGER_AGENT_MODEL_HOTEL=qwen3:14b
# VOYAGER_AGENT_MODEL_EXPERIENCE=qwen3:14b
# VOYAGER_AGENT_MODEL_ITINERARY=mistral-small3.1:24b

# Web search snippets. Disable when you want a fully offline run.
VOYAGER_ENABLE_SEARCH=true
VOYAGER_SEARCH_PROVIDER=duckduckgo
VOYAGER_SEARCH_MAX_RESULTS=4

# Increase this for large local models.
VOYAGER_REQUEST_TIMEOUT_S=180

# Ollama context window in tokens. The itinerary agent reads all four research
# reports, so keep this at 16384 unless memory is tight (8192 for small laptops).
VOYAGER_OLLAMA_NUM_CTX=16384
