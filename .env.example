# LLM backend. Defaults to local Ollama.
VOYAGER_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Alternative local/server backend for LM Studio, vLLM, llama.cpp server, etc.
# VOYAGER_LLM_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPATIBLE_API_KEY=

# NVIDIA NIM hosted open models (free tier). The nim provider picks its own models and
# ignores VOYAGER_MODEL_PRESET; per-agent overrides below still apply.
# VOYAGER_LLM_PROVIDER=nim
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Structured-output mode: json_schema, nvext_guided, vllm_guided or json_object.
# Leave unset for the provider default.
# VOYAGER_SCHEMA_MODE=json_schema

# Transport attempts per model call, for HTTP 429, 5xx and connection errors (minimum 1).
# Default 3, or 5 on the nim provider. A 429 waits at least 15 s between attempts.
# Invalid structured output gets exactly one repair attempt; that is not configurable.
# VOYAGER_LLM_RETRIES=3

# Ollama thinking: false (default), true, or default to leave it to the model.
# VOYAGER_OLLAMA_THINK=false

# Model calls allowed at once. 0 means automatic: 1 on Ollama, 4 elsewhere.
# VOYAGER_LLM_CONCURRENCY=0

# Model presets: small, balanced, quality.
VOYAGER_MODEL_PRESET=balanced

# Optional per-agent overrides.
# VOYAGER_AGENT_MODEL_DISCOVERY=qwen3:14b
# VOYAGER_AGENT_MODEL_FLIGHT=mistral-small3.1:24b
# VOYAGER_AGENT_MODEL_VISA=mistral-small3.1:24b
# VOYAGER_AGENT_MODEL_HOTEL=qwen3:14b
# VOYAGER_AGENT_MODEL_EXPERIENCE=qwen3:14b
# VOYAGER_AGENT_MODEL_ITINERARY=mistral-small3.1:24b

# Web search and page reading. Disable when you want a fully offline run.
VOYAGER_ENABLE_SEARCH=true
VOYAGER_SEARCH_PROVIDER=duckduckgo
# Results per search query; each research agent runs 3 queries.
VOYAGER_SEARCH_MAX_RESULTS=4
# Attempts per web search (minimum 1).
# VOYAGER_SEARCH_RETRIES=2
# Top search results each research agent reads in full (0 turns page fetching off).
# VOYAGER_FETCH_PAGES=3
# Characters of readable text kept per fetched page (minimum 500).
# VOYAGER_PAGE_CHARS=4000

# Increase this for large local models.
VOYAGER_REQUEST_TIMEOUT_S=180

# Ollama context window in tokens (minimum 4096). The itinerary agent reads all
# four research reports. With a smaller window the reports are trimmed to fit, so
# lowering this saves memory at the cost of detail in the final itinerary.
VOYAGER_OLLAMA_NUM_CTX=16384

# Characters of each research report passed to the itinerary agent. Leave unset
# for automatic: sized to the context window on Ollama, 12000 elsewhere. Set it
# when an OpenAI-compatible server is loaded with a small context (try 1100 for 4096).
# VOYAGER_RESEARCH_CONTEXT_CHARS=12000
